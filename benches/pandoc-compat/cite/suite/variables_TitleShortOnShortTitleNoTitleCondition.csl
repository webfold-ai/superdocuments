<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <citation>
    <layout>
      <choose>
        <if variable="title-short">
          <group delimiter=" ">
            <text variable="title"/>
            <group>
              <text value="has title-short"/>
            </group>
          </group>
        </if>
        <else>
          <group delimiter=" ">
            <text variable="title"/>
            <group>
              <text value="does not have title-short"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
</style>