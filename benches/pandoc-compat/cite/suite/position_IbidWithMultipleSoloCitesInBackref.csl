<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name form="short" />
    </names>
  </macro>
  <citation>
    <sort>
      <key macro="author" />
    </sort>
    <layout delimiter="; ">
      <choose>
        <if position="ibid">
          <text term="ibid"/>
        </if>
        <else>
          <text macro="author" />
        </else>
      </choose>
    </layout>
  </citation>
</style>