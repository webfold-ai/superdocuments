<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <citation>
    <layout delimiter="; ">
      <choose>
        <if position="ibid">
          <text value="ibid"/>
        </if>
        <else>
          <group delimiter=", ">
            <text variable="title"/>
            <group delimiter=" ">
              <text value="n"/>
              <text variable="first-reference-note-number"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
</style>