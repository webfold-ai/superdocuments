<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <macro name="date">
    <date variable="issued" date-parts="year" form="numeric"/>
  </macro>
  <citation>
    <sort>
      <key macro="date" />
      <key variable="title" />
    </sort>
    <layout delimiter="; ">
      <text variable="title" />
    </layout>
  </citation>
</style>