<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <citation disambiguate-add-givenname="true">
    <layout>
      <group delimiter=", ">
        <names variable="author">
          <name form="short" and="text"/>
        </names>
        <choose>
          <if disambiguate="true">
            <text variable="title"/>
          </if>
        </choose>
      </group>
    </layout>
  </citation>
</style>