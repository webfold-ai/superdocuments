<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <macro name="title">
    <choose>
      <if type="article-journal">
        <text variable="title" quotes="true"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <citation>
    <layout delimiter="; ">
      <text macro="title"/>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key macro="title"/>
    </sort>
    <layout>
      <text macro="title"/>
    </layout>
  </bibliography>
</style>