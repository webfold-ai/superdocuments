<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name form="short" />
    </names>
  </macro>
  <citation>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author" />
        <text variable="title"/>
      </group>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <choose>
        <if match="none" type="personal_communication">
          <group delimiter=". ">
            <group delimiter=", ">
              <text macro="author" />
              <text variable="title"/>
            </group>
          </group>
        </if>
      </choose>
    </layout>
  </bibliography>
</style>