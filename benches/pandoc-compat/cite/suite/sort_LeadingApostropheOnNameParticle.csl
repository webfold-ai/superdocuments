<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0"
      demote-non-dropping-particle="never">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name initialize-with=" " initialize="true" name-as-sort-order="all"/>
    </names>
  </macro>
  <citation>
    <layout>
      <text value="BOGUS"/>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key variable="author" />
    </sort>
    <layout>
      <text macro="author" />
    </layout>
  </bibliography>
</style>