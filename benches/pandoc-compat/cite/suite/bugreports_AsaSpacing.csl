<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <locale>
    <style-options punctuation-in-quote="true"/>
  </locale>
  <macro name="title">
    <text variable="title" quotes="true"/> 
  </macro>
  <citation>
    <layout>
      <text value="bogus"/>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <group delimiter=" ">
        <text macro="title" suffix="."/>
        <text value="Some text string"/>
      </group>
    </layout>
  </bibliography>
</style>