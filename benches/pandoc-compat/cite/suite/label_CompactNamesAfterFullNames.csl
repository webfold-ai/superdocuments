<style 
      xmlns="http://purl.org/net/xbiblio/csl"
      class="note"
      version="1.0">
  <info>
    <id />
    <title />
    <updated>2009-08-10T04:49:00+09:00</updated>
  </info>
  <citation>
    <layout>
      <names variable="author">
        <name/>
        <label prefix=", "/>
        <substitute>
          <names variable="translator">
            <name/>
            <label form="short" prefix=" "/>
          </names>
          <names variable="editor"/>
        </substitute>
      </names>
    </layout>
  </citation>
</style>